# Copy this file to .env for local dev:  cp .env.example .env
# .env is git-ignored. Never commit real secrets.

DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=True
# Add your laptop's LAN IP (e.g. 192.168.1.20) to test from a real phone
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Linux / WSL only: your user and group ids (run `id -u` and `id -g`), so files created
# inside the container belong to you. Mac and Windows (Docker Desktop) can leave these.
LOCAL_UID=1000
LOCAL_GID=1000

# Photo storage: "local" saves uploads under backend/media (dev only).
# Production uses "s3" with the S3_* variables below (Cloudflare R2 / Supabase Storage).
PHOTO_STORAGE=local
# S3_ENDPOINT_URL=
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# PHOTO_PUBLIC_BASE_URL=

# Only needed if a browser app (e.g. Expo web) calls the API
# CORS_ALLOWED_ORIGINS=http://localhost:8081

# Reputation rules (placeholders, see 01-features.md F8). Defaults shown.
# REP_SUBMISSION_APPROVED=10
# REP_SUBMISSION_REJECTED=-15
# REP_REVIEW_COMPLETED=2
# MODERATOR_REPUTATION=100

# Local: DATABASE_URL is set in docker-compose.yml, leave it out here.
# Production (Render env var): Supabase "Session pooler" string, port 5432, e.g.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
